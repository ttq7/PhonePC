<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp">

        <CheckBox
            android:id="@+id/apiOn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_api_enable"
            android:textColor="@color/win_text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_api_endpoint"
            android:textColor="@color/win_text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/apiEndpoint"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_dialog_input"
            android:hint="@string/settings_api_endpoint_hint"
            android:inputType="textUri"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="@color/win_text"
            android:textColorHint="@color/win_text_disabled"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/settings_api_model"
            android:textColor="@color/win_text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/apiModel"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_dialog_input"
            android:hint="@string/settings_api_model_hint"
            android:inputType="text"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="@color/win_text"
            android:textColorHint="@color/win_text_disabled"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/settings_api_key"
            android:textColor="@color/win_text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/apiKey"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_dialog_input"
            android:hint="@string/settings_api_key_hint"
            android:inputType="textPassword"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="@color/win_text"
            android:textColorHint="@color/win_text_disabled"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_api_note"
            android:textColor="@color/win_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
