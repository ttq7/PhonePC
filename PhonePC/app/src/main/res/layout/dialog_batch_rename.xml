<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="4dp"
        android:paddingEnd="22dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/batch_find"
            android:textColor="@color/win_text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/findInput"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/bg_dialog_input"
            android:hint="@string/batch_find_hint"
            android:inputType="text"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="@color/win_text"
            android:textColorHint="@color/win_text_disabled"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/batch_replace"
            android:textColor="@color/win_text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/replaceInput"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/bg_dialog_input"
            android:inputType="text"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="@color/win_text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/batch_template"
            android:textColor="@color/win_text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/tplInput"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/bg_dialog_input"
            android:inputType="text"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="@color/win_text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/batch_template_help"
            android:textColor="@color/win_text_disabled"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/batch_start"
            android:textColor="@color/win_text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/startInput"
            android:layout_width="110dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_dialog_input"
            android:inputType="number"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="@color/win_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/previewText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dialog_input"
            android:padding="10dp"
            android:textColor="@color/win_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
